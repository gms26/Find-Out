# Copy to .env and fill in your own values. Never commit .env.
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/findout_hotels
# Comma-separated origins allowed to call the API (Vite = 5173, CRA = 3000)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
